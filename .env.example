# Copy to .env and fill in what you need. Every setting is optional; the
# commented values are the defaults.

# --- Dashboard ---------------------------------------------------------------
# Use HOST=0.0.0.0 to reach the dashboard from other devices (then set BASIC_AUTH).
# (Docker Compose sets HOST, PORT and DATA_DIR itself.)
# HOST=127.0.0.1
# PORT=3000
# BASIC_AUTH=admin:change-me

# --- Tracking rules ----------------------------------------------------------
# How often Polymarket is checked, in minutes.
# POLL_INTERVAL_MINUTES=5
# A trade qualifies when shares x price is strictly greater than this many USD.
# MIN_TRADE_USD=30
# Trades the API reports late are still alerted if they are at most this many
# minutes older than the newest qualifying trade already seen for the account.
# LATE_TRADE_GRACE_MINUTES=60
# When an account starts being tracked (including the pre-loaded AI accounts on
# the very first start), also alert on its qualifying trades from the past N
# hours. Handy for seeing the app work right away; 0 = only new trades.
# BACKFILL_HOURS=0
# Only send notifications for trades at most this many minutes old (older ones
# are still listed in the dashboard). 0 = no limit.
# NOTIFY_MAX_AGE_MINUTES=0
# Alerts kept in history (all categories together).
# MAX_ALERTS=1000
# Where state (tracked accounts, alert history) is saved.
# DATA_DIR=./data

# --- Push notifications (configure any number of them) ------------------------
# Telegram: create a bot with @BotFather, send it a message, then get your chat
# id from https://api.telegram.org/bot<TOKEN>/getUpdates. Several chat ids can
# be comma-separated.
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=123456789

# Discord: Server settings -> Integrations -> Webhooks -> New webhook -> Copy URL.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Slack: create an Incoming Webhook for a channel.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# ntfy (free phone/desktop push, no account needed): pick a hard-to-guess topic
# and subscribe to it in the ntfy app.
# NTFY_TOPIC=polymarket-tracker-7f3k2q
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOKEN=

# Generic webhook: receives a JSON POST for every alert.
# WEBHOOK_URL=https://example.com/hooks/polymarket

# --- Advanced ------------------------------------------------------------------
# Which Polymarket trades endpoint to use: auto (v2, falling back to the legacy
# endpoint), v2 or v1.
# POLYMARKET_TRADES_API=auto
# POLYMARKET_DATA_API_URL=https://data-api.polymarket.com
# POLYMARKET_GAMMA_API_URL=https://gamma-api.polymarket.com
